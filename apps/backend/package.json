{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node ./tests/runJest.js --runInBand --forceExit",
    "test:watch": "node ./tests/runJest.js --watch --runInBand",
    "test:coverage": "node ./tests/runJest.js --coverage --runInBand --forceExit",
    "test:auth": "node ./tests/runJest.js --testPathPattern=modules/auth --runInBand --forceExit",
    "test:announcements": "node ./tests/runJest.js --testPathPattern=modules/announcements --runInBand --forceExit",
    "test:users": "node ./tests/runJest.js --testPathPattern=modules/users --runInBand --forceExit",
    "test:memberships": "node ./tests/runJest.js --testPathPattern=modules/memberships --runInBand --forceExit",
    "test:workouts": "node ./tests/runJest.js --testPathPattern=modules/workouts --runInBand --forceExit",
    "test:payments": "node ./tests/runJest.js --testPathPattern=modules/payments --runInBand --forceExit",
    "test:fitness-records": "node ./tests/runJest.js --testPathPattern=modules/fitness-records --runInBand --forceExit",
    "test:admin": "node ./tests/runJest.js --testPathPattern=modules/admin --runInBand --forceExit",
    "test:notifications": "node ./tests/runJest.js --testPathPattern=modules/notifications --runInBand --forceExit",
    "test:occupancy": "node ./tests/runJest.js --testPathPattern=modules/occupancy --runInBand --forceExit",
    "test:streaks": "node ./tests/runJest.js --testPathPattern=modules/streaks --runInBand --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.2.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/__test__/**/*.test.js",
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "modules/**/*.js",
      "middlewares/**/*.js",
      "utils/**/*.js",
      "!**/*.validation.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "devDependencies": {
    "jest": "^25.0.0",
    "supertest": "^7.2.2"
  }
}
